public class MultiplyThreeNumbers {
    public static void main(String[] args) {
        // Define three numbers
        int num1 = 5;
        int num2 = 10;
        int num3 = 2;
        
        // Calculate the product
        int product = num1 * num2 * num3;
        
        // Display the result
        System.out.println("The product is: " + product);
    }
}
